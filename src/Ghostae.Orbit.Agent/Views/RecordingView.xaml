<UserControl x:Class="Ghostae.Orbit.Agent.Views.RecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Screen Recording" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="High performance Windows screen capture and video export" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Recording Setup Card -->
            <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Recording Configuration" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Text="{Binding Target}" IsEditable="False" Padding="8,6" Background="{StaticResource BgWhiteBrush}">
                            <ComboBoxItem Content="Full Screen" IsSelected="True"/>
                            <ComboBoxItem Content="Monitor"/>
                            <ComboBoxItem Content="Window"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Text="{Binding Quality}" IsEditable="False" Padding="8,6" Background="{StaticResource BgWhiteBrush}">
                            <ComboBoxItem Content="High" IsSelected="True"/>
                            <ComboBoxItem Content="Standard"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output Location" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OutputLocation, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource OrbitTextBox}"/>
                    </Grid>

                    <!-- Active Recording Status Banner (Visible when recording) -->
                    <Border Background="{StaticResource AccentRedSubtleBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,20"
                            Visibility="{Binding IsRecording, Converter={x:Null}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="{StaticResource AccentRedBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Recording" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DurationText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentRedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Large Primary Toggle Button -->
                    <Button Command="{Binding ToggleRecordingCommand}" Style="{StaticResource OrbitPrimaryButton}" Height="46" FontSize="14" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRecording}" Fill="{StaticResource TextWhiteBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding IsRecording, Converter={x:Null}}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Start Recording" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Completed Recording Summary Card -->
            <Border Style="{StaticResource OrbitCard}" Visibility="{Binding HasLastRecording, Converter={x:Null}}">
                <StackPanel>
                    <TextBlock Text="Completed Recording" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Duration" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LastDuration}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="File Size" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LastSize}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="File Path" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LastFilePath}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Show in Folder" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding ShowInFolderCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                        <Button Content="Open Video" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding OpenLastFileCommand}" Padding="12,6" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
