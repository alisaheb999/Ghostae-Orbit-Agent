<UserControl x:Class="Ghostae.Orbit.Agent.Views.TestDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Capabilities Self-Test" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Test and verify all local execution tools, Adobe bridges, media capture, and security guards on-demand." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Reset" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding ResetAllCommand}" Margin="0,0,10,0" Padding="14,8" FontSize="13"/>
                    <Button Content="Run All Diagnostics" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding RunAllCommand}" Padding="18,8" FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- Diagnostics Summary Card -->
            <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallStatusText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Passed: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding PassedTests}" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" FontSize="13"/>
                                <TextBlock Text=" • Failed: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding FailedTests}" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" FontSize="13"/>
                                <TextBlock Text=" • Total: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding TotalTests}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Progress Percentage -->
                        <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Style="{StaticResource OrbitProgressBar}" Value="{Binding OverallProgress}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Test Items List -->
            <ItemsControl ItemsSource="{Binding Tests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Test Header Line -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Test Info -->
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="1" Text="{Binding DurationFormatted}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,16,0"/>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="2" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="{StaticResource BgSubtleBrush}">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColorBrush}"/>
                                    </Border>

                                    <!-- Run Test Button -->
                                    <Button Grid.Column="3" Content="Run Test" Style="{StaticResource OrbitSecondaryButton}" 
                                            Command="{Binding DataContext.RunSingleTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanRun}"
                                            Padding="12,6" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Live Summary / Result Line -->
                                <Border Margin="0,10,0,0" Padding="12,8" Background="{StaticResource BgSubtleBrush}" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,110,0"/>
                                        <Button Content="{Binding ExpandButtonText}" 
                                                Command="{Binding ToggleExpandCommand}" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" 
                                                Foreground="{StaticResource AccentRedBrush}" 
                                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                Visibility="{Binding ButtonVisibility}"/>
                                    </Grid>
                                </Border>

                                <!-- Expandable Details / JSON / Preview -->
                                <StackPanel Visibility="{Binding DetailsVisibility}" Margin="0,10,0,0">
                                    <!-- Screenshot Thumbnail Preview if available -->
                                    <Border Margin="0,0,0,8" Visibility="{Binding ScreenshotVisibility}" CornerRadius="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" MaxHeight="180" HorizontalAlignment="Left">
                                        <Image Source="{Binding ScreenshotPath}" Stretch="Uniform" Margin="4"/>
                                    </Border>

                                    <!-- Formatted JSON Output Box -->
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12">
                                        <TextBox Text="{Binding RawOutput, Mode=OneWay}" 
                                                 Background="Transparent" Foreground="#E2E8F0" 
                                                 FontFamily="Consolas, Cascadia Code, Courier New" 
                                                 FontSize="11" BorderThickness="0" 
                                                 IsReadOnly="True" TextWrapping="Wrap" 
                                                 MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
