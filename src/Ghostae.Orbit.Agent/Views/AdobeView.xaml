<UserControl x:Class="Ghostae.Orbit.Agent.Views.AdobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Adobe Studio Control Center" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Direct studio controls for Premiere Pro, After Effects, real-time saving, background rendering, and visual verification." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="↻ Refresh Status" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" FontSize="13"/>
            </Grid>

            <!-- Quick Studio Action Toolbar Card -->
            <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Studio Quick Test Actions" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <WrapPanel Margin="0,0,0,4">
                        <!-- Premiere Actions -->
                        <Button Content="▶ Launch Premiere Pro" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding LaunchPrCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                        <!-- After Effects Actions -->
                        <Button Content="▶ Launch After Effects" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding LaunchAeCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                        <!-- Save Actions -->
                        <Button Content="💾 Save Project (Ctrl+S)" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding SavePrCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                        <!-- Render Action -->
                        <Button Content="⚡ Render Video" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding RenderPrCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                        <!-- Screenshot Action -->
                        <Button Content="📷 Get Screenshot" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding CaptureScreenshotCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                        <!-- Screen Record Action -->
                        <Button Content="🎥 Get Screen Record" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding QuickRecordCommand}" Margin="0,0,10,10" Padding="14,9" FontSize="12"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Live Action Console & Feedback Card -->
            <Border Background="#0F172A" CornerRadius="10" Padding="18,14" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Live Execution Console" FontWeight="SemiBold" FontSize="13" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button Content="Open Saved Output File ↗" Style="{StaticResource OrbitSecondaryButton}" 
                                Command="{Binding OpenLastFileCommand}" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Padding="10,4" FontSize="11" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569"/>
                    </Grid>

                    <TextBlock Text="{Binding ActionStatusMessage}" FontSize="14" FontWeight="Medium" Foreground="#F8FAFC" Margin="0,10,0,4" TextWrapping="Wrap"/>

                    <!-- Action Progress Bar -->
                    <ProgressBar Style="{StaticResource OrbitProgressBar}" Value="{Binding ActionProgress}" Margin="0,8,0,0"/>

                    <!-- Last Screenshot Preview if available -->
                    <Border Margin="0,12,0,0" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" MaxHeight="160" HorizontalAlignment="Left" Visibility="{Binding HasLastScreenshot, Converter={x:Null}}">
                        <Image Source="{Binding LastScreenshotPath}" Stretch="Uniform" Margin="4"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Adobe App Cards Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Premiere Pro Card -->
                <Border Grid.Column="0" Style="{StaticResource OrbitCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#26133B" VerticalAlignment="Center">
                                    <TextBlock Text="Pr" FontWeight="Bold" FontSize="16" Foreground="#EA77FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Premiere Pro" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PrProcessStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PrProcessStatusColor}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="8,4" Background="{StaticResource BgSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrRenderStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,2,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Version" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PrVersion}" HorizontalAlignment="Right" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Active Project" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PrActiveProject}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentRedBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Bridge Connection" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Active Listener (Port 18924)" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource StatusGreenBrush}"/>
                        </Grid>

                        <!-- Actions Inside Card -->
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Launch App" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding LaunchPrCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Open Project..." Style="{StaticResource OrbitSecondaryButton}" Command="{Binding OpenPrProjectCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Save (Ctrl+S)" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding SavePrCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Render" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding RenderPrCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- After Effects Card -->
                <Border Grid.Column="2" Style="{StaticResource OrbitCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#0C1B33" VerticalAlignment="Center">
                                    <TextBlock Text="Ae" FontWeight="Bold" FontSize="16" Foreground="#9999FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="After Effects" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AeProcessStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AeProcessStatusColor}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="8,4" Background="{StaticResource BgSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AeRenderStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,2,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Version" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AeVersion}" HorizontalAlignment="Right" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Active Project" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AeActiveProject}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentRedBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Bridge Connection" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Active Listener (Port 18923)" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource StatusGreenBrush}"/>
                        </Grid>

                        <!-- Actions Inside Card -->
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Launch App" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding LaunchAeCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Open Project..." Style="{StaticResource OrbitSecondaryButton}" Command="{Binding OpenAeProjectCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Save (Ctrl+S)" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding SaveAeCommand}" Margin="0,0,8,6" Padding="12,6" FontSize="12"/>
                            <Button Content="Render (aerender)" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding RenderAeCommand}" Margin="0,0,0,6" Padding="12,6" FontSize="12"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
