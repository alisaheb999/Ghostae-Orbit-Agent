<UserControl x:Class="Ghostae.Orbit.Agent.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Orbit Agent" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Your desktop execution layer" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Top Agent Status Card -->
            <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Orb Indicator -->
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentRedSubtleBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCloud}" Fill="{StaticResource AccentRedBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AgentStatusTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource StatusGreenBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Server: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding ServerStatusText}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text=" • Heartbeat: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding HeartbeatText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="AUTONOMOUS AGENT ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Middle Cards Grid (System Status & Adobe Environment) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- System Status Card -->
                <Border Grid.Column="0" Style="{StaticResource OrbitCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDesktop}" Fill="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Windows Environment" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WindowsStatus}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StatusGreenBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource OrbitProgressBar}" Value="{Binding CpuPercentValue}" Height="4" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="RAM" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RamText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource OrbitProgressBar}" Value="{Binding RamPercentValue}" Height="4" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,0">
                            <TextBlock Text="Storage" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding StorageText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Adobe Environment Card -->
                <Border Grid.Column="2" Style="{StaticResource OrbitCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAdobe}" Fill="{StaticResource AccentRedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Adobe Environment" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="After Effects" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AeStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Premiere Pro" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PrStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Current Project" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActiveProject}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentRedBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <TextBlock Text="Current Task" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AdobeCurrentTask}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Current Task Card -->
            <Border Style="{StaticResource OrbitCard}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTasks}" Fill="{StaticResource AccentRedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveTaskName}" FontWeight="Bold" FontSize="16" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveTaskApp}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveTaskProgress, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentRedBrush}"/>
                    </Grid>

                    <ProgressBar Style="{StaticResource OrbitProgressBar}" Value="{Binding ActiveTaskProgress}" Margin="0,0,0,12"/>

                    <Grid>
                        <TextBlock Text="{Binding ActiveTaskStatus}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="View Task" Style="{StaticResource OrbitSecondaryButton}" Command="{Binding ViewTaskCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                            <Button Content="Cancel" Style="{StaticResource OrbitPrimaryButton}" Command="{Binding CancelTaskCommand}" Padding="12,6" FontSize="12" IsEnabled="{Binding HasActiveTask}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Task History Compact List -->
            <Border Style="{StaticResource OrbitCard}">
                <StackPanel>
                    <TextBlock Text="Recent Operations" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding RecentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLightBrush}" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource StatusGreenBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Application}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StatusGreenBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TimeDisplay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
