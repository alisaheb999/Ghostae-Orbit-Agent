<Application x:Class="Ghostae.Orbit.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ghostae.Orbit.Agent.ViewModels"
             xmlns:views="clr-namespace:Ghostae.Orbit.Agent.Views"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel to View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                <views:TasksView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DesktopViewModel}">
                <views:DesktopView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdobeViewModel}">
                <views:AdobeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordingViewModel}">
                <views:RecordingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScreenshotViewModel}">
                <views:ScreenshotView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FilesViewModel}">
                <views:FilesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TestDiagnosticsViewModel}">
                <views:TestDiagnosticsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
